APP_URL=http://localhost:3000
DEFAULT_LOCALE=vi
SUPPORTED_LOCALES=vi,en

# Production and Vercel must use postgres. `npm run dev` selects pglite locally.
STORAGE_DRIVER=postgres
DATABASE_URL=postgresql://shibaquiz:shibaquiz@localhost:5432/shibaquiz
DATABASE_SSL=false
PGLITE_DATA_DIR=./data/pglite

# Reserved for the authentication slice.
AUTH_SECRET=
AUTH_BCRYPT_COST=12
AUTH_SESSION_DAYS=7
# Secure default. Set false to let new accounts sign in without an email round trip.
REQUIRE_EMAIL_VERIFICATION=true
EMAIL_PROVIDER=console
EMAIL_FROM=
EMAIL_API_KEY=

# Optional one-off admin seed. No default credentials are provided.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_DISPLAY_NAME=
SEED_ADMIN_CONFIRM=
SEED_ADMIN_PRODUCTION_CONFIRM=

# Private S3-compatible object storage. No local runtime-filesystem driver exists.
MEDIA_STORAGE_DRIVER=s3
MEDIA_S3_REGION=auto
MEDIA_S3_ENDPOINT=
MEDIA_S3_BUCKET=
MEDIA_S3_ACCESS_KEY_ID=
MEDIA_S3_SECRET_ACCESS_KEY=
MEDIA_S3_FORCE_PATH_STYLE=false
MEDIA_SIGNED_URL_TTL_SECONDS=300
MEDIA_MAX_IMAGE_MB=5
MEDIA_MAX_AUDIO_MB=25
MEDIA_MAX_VIDEO_MB=100
