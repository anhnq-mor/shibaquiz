{
  "name": "shibaquiz",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "license": "UNLICENSED",
  "author": "",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "npm run db:setup:local && cross-env NODE_ENV=development STORAGE_DRIVER=pglite PGLITE_DATA_DIR=./data/pglite next dev --webpack",
    "dev:postgres": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "catalog:check": "tsx scripts/check-catalogs.ts",
    "metadata:check": "tsx scripts/check-project-metadata.ts",
    "db:generate": "drizzle-kit generate",
    "db:inspect": "cross-env NODE_ENV=development STORAGE_DRIVER=pglite PGLITE_DATA_DIR=./data/pglite tsx scripts/inspect-db.ts",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "db:seed:admin": "tsx scripts/seed-admin.ts",
    "db:setup:local": "cross-env NODE_ENV=development STORAGE_DRIVER=pglite PGLITE_DATA_DIR=./data/pglite tsx scripts/setup-local.ts",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm run catalog:check && npm run metadata:check && npm test && npm run build"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.5.4",
    "@aws-sdk/client-s3": "3.1102.0",
    "@aws-sdk/s3-request-presigner": "3.1102.0",
    "bcryptjs": "3.0.3",
    "drizzle-orm": "0.45.2",
    "next": "16.3.0",
    "postgres": "3.4.9",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.3.0",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "cross-env": "10.1.0",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.2",
    "eslint-config-next": "16.3.0",
    "prettier": "3.9.6",
    "prettier-plugin-tailwindcss": "0.8.1",
    "tailwindcss": "4.3.3",
    "tsx": "4.20.5",
    "typescript": "5.9.3",
    "typescript-eslint": "8.50.0",
    "vitest": "3.2.7"
  },
  "overrides": {
    "typescript-eslint": "8.50.0"
  }
}
